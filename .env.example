# Used by Scripts/bundle.sh and Scripts/release.sh. Copy to .env and fill in.
# Developer ID certificate name, as listed by `security find-identity -v -p codesigning`
IDENTITY_DARWIN_CODE="Developer ID Application: Your Name (TEAMID)"
# Notarization credentials (app-specific password from appleid.apple.com)
APPLE_ID="you@example.com"
APPLE_TEAM_ID="TEAMID"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
